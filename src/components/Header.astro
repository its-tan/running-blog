---
import LangSwitcher from './LangSwitcher.astro';
import { ui, type Lang } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'vi') as Lang;
const base = import.meta.env.BASE_URL;
const t = ui[locale];
---
<header class="border-b border-stone-200">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5">
    <a href={`${base}${locale}/`} class="font-semibold tracking-tight">🏃 Running Blog</a>
    <nav class="flex items-center gap-4">
      <a href={`${base}${locale}/`} class="text-sm hover:text-emerald-700">{t['nav.home']}</a>
      <LangSwitcher />
    </nav>
  </div>
</header>
