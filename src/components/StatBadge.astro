---
interface Props {
  label: string;
  value: string;
}
const { label, value } = Astro.props;
---
<span class="inline-flex items-center gap-1 rounded-full border border-stone-300 px-3 py-1 text-xs">
  <span class="text-stone-500">{label}</span>
  <span class="font-semibold text-stone-900">{value}</span>
</span>
