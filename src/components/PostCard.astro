---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  locale: Lang;
}

const { href, title, description, pubDate, tags, locale } = Astro.props;
const t = ui[locale];
const dateLabel = pubDate.toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="border-b border-stone-200 py-6 first:pt-0">
  <a href={href} class="text-xl font-semibold hover:text-emerald-700">{title}</a>
  <p class="mt-1 text-sm text-stone-500">{t['post.publishedOn']} {dateLabel}</p>
  <p class="mt-2 text-stone-700">{description}</p>
  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li class="rounded-full bg-emerald-50 px-3 py-1 text-xs text-emerald-700">#{tag}</li>
      ))}
    </ul>
  )}
  <a href={href} class="mt-3 inline-block text-sm font-medium text-emerald-700 hover:underline">
    {t['post.readmore']} →
  </a>
</article>
