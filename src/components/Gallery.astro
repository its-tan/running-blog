---
// Gallery ảnh cho bài viết — dùng astro:assets để tự resize/nén ảnh.
// Cách dùng: import ảnh trong file .astro của bài viết rồi truyền vào props "images".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---
<div class="my-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
  {images.map((img) => (
    <Image
      src={img.src}
      alt={img.alt}
      width={600}
      height={450}
      loading="lazy"
      class="aspect-[4/3] rounded-lg object-cover"
    />
  ))}
</div>
