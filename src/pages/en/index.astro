---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../i18n/ui';

const t = ui.en;
const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title={`${t['home.title']} — Running Blog`} description={t['home.subtitle']}>
  <h1 class="text-3xl font-bold tracking-tight">{t['home.title']}</h1>
  <p class="mt-2 text-stone-600">{t['home.subtitle']}</p>
  <div class="mt-8">
    {posts.map((post) => (
      <PostCard
        href={`${base}en/blog/${post.id.replace(/^en\//, '')}/`}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        locale="en"
      />
    ))}
  </div>
</BaseLayout>
